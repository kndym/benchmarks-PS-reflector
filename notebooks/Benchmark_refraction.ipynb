    "import numpy as np\n",
    "from refracter.cost import get_cost_function\n",
    "from refracter.sinkhorn import entropic_ot_cost\n",
    "\n",
    "# Select 'l2' (squared Euclidean cost) or 'refraction'.\n",
    "# The default L2 cost is independent of kappa.\n",
    "OT_COST_FUNCTION = 'l2'\n",
    "if OT_COST_FUNCTION == 'refraction':\n",
    "    ot_cost_fn = get_cost_function(OT_COST_FUNCTION, kappa=kappa)\n",
    "else:\n",
    "    ot_cost_fn = get_cost_function(OT_COST_FUNCTION)\n",
    "\n",
    "# Compare the pushed source measure with the target measure using equation\n",
    "# (2.1) from the paper. y_push_3d follows the supported source points, so\n",
    "# p[mask_p] supplies their masses and q[mask_q] weights the target support.\n"
    "p_push = np.asarray(p[mask_p], dtype=float)\n",
    "y_push = np.asarray(y_push_3d, dtype=float)\n",
    "target_mask = q > 0\n",
    "y_target = np.asarray(y[target_mask], dtype=float)\n",
    "q_target = np.asarray(q[target_mask], dtype=float)\n",
    "\n",
    "if len(y_push) != len(p_push):\n",
    "    raise ValueError('Expected one pushed point for each supported source atom.')\n",
    "\n",
    "k_ot = 8 * int(np.floor(np.sqrt(NK)))\n",
    "epsilon_ot = 1.0 / k_ot\n",
    "ot_push_target, ot_info = entropic_ot_cost(\n",
    "    y_push,\n",
    "    y_target,\n",
    "    p_push,\n",
    "    q_target,\n",
    "    epsilon=epsilon_ot,\n",
    "    cost_fn=ot_cost_fn,\n",
    "    return_info=True,\n",
    ")\n",
    "\n",
    "print(f'Push-forward to target OT_epsilon (equation 2.1): {ot_push_target:.6e}')\n",
    "print(f'cost={OT_COST_FUNCTION}, epsilon={epsilon_ot:.6g}, iterations={ot_info[\"iterations\"]}')\n",
    "print(f'Sinkhorn converged: {ot_info[\"converged\"]} (potential change={ot_info[\"potential_change\"]:.3e})')\n"
   ]
