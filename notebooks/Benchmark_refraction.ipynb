    "    C_blk            = cost_matrix_chunk(x_ei[i0:i1], y_supp)\n",
    "    vals             = b_fraw[None, :] - k_ei * C_blk\n",
    "    f_ei_raw[i0:i1]  = _logsumexp(vals, axis=1) / (-k_ei)\n",
    "print(f'f_tilde_raw: min={f_ei_raw.min():.4f}  max={f_ei_raw.max():.4f}')\n",
    "\n",
