    "if identity_used:\n",
    "    logp_all = np.where(p > 0, np.log(p), -np.inf)\n",
    "    b_fid    = k_ei * f_id + logp_all\n",
    "\n",
    "    f_ei_id  = np.empty(M_ei, dtype=np.float64)\n",
    "    for i0 in range(0, M_ei, chunk_ei):\n",
