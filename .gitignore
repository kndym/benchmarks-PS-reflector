# Local assistant/editor state never belongs on GitHub.
.claude/
.cursor/
.agents/
.codex/
.research/
AGENTS.md
CLAUDE.md
**/__pycache__/
.pytest_cache/

# Generated media is published only inside documented artifact folders.
*.jpg
*.jpeg
*.png
*.html
!/results/**/plots/*.png
!/results/**/interactive/*.html
!/archive/**/plots/*.png
!/archive/**/interactive/*.html
!/notebooks/archive/**/plots/*.png
!/notebooks/archive/**/interactive/*.html
!/geometric_optics_progress/images/*.png

# Operational logs and one-off smoke outputs remain local, with README indexes.
**/*.pid
**/*.log
**/*.err
**/queued_run.json
**/run_manifest.json
**/logs/*
!**/logs/README.md
/results/local_runtime/**
!/results/local_runtime/**/
!/results/local_runtime/**/README.md
/results/archive/smoke_checks/**
!/results/archive/smoke_checks/**/
!/results/archive/smoke_checks/**/README.md

# Compiler/editor intermediates and temporary export packages.
/BenchmarkCode/*.exe
/BenchmarkCode/main
/BenchmarkCode/main_fast
/BenchmarkCode/main_compare
*.o
*.obj
/geometric_optics_progress/*.aux
/geometric_optics_progress/*.log
/geometric_optics_progress/*.pdf
/geometric_optics_progress/*.out
/geometric_optics_progress/exports/*.zip
/geometric_optics_progress/metadata/overleaf_sync.json
**/*.synctex.gz
/archive/writeup_exports_oct_27_26/packages/*.zip
/results/examples/refractor_surfaces_sep_24_26/source/*.aux
/results/examples/refractor_surfaces_sep_24_26/source/*.log
/results/examples/refractor_surfaces_sep_24_26/source/*.pdf
