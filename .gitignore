# Local workers and disposable test output; published snapshots are immutable.
/results/**/*.pid
/results/**/*.log
/results/**/*.err
/results/**/queued_run.json
/results/**/run_manifest.json
/results/*smoke*/
/results/refraction_sweeps_extended_entropic_high_iter/
/results/refraction_sweeps_extended_debiased_comparison/
/results/refraction_worker_supervision/
/geometric_optics_progress.zip
/geometric_optics_progress/*.aux
/geometric_optics_progress/*.log
/geometric_optics_progress/*.pdf
/geometric_optics_progress/*.out
**/__pycache__/
CLAUDE.md
/results/sinkhorn_refracter_examples

# Keep the refreshed refracter archives and figures available to the notebook
# when the repository is cloned from GitHub.  Other generated result bundles
# remain ignored by the rule above.
!/results/sinkhorn_refracter_examples/
