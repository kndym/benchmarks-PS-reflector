!/results/sinkhorn_refracter_examples/case_*/*.npz
!/results/sinkhorn_refracter_examples/case_*/*.png
/results/sinkhorn_refracter_examples/*.aux
/results/sinkhorn_refracter_examples/*.log
/results/sinkhorn_refracter_examples/*.pdf
